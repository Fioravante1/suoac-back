// ============================================================
// SUOAC - Sistema Unificado de Ônibus para Assembleias e Congressos
// Prisma Schema v2.0
// Database: Neon PostgreSQL (Serverless)
// ============================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Sem a extensão explícita, o Prisma a infere do `moduleResolution` do tsconfig e passa
  // a emitir `./internal/class.js` sob `nodenext` — o que o jest-resolve (CJS) não resolve.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CIRCUIT_COORDINATOR
  CIRCUIT_ASSISTANT
  CONGREGATION_COORDINATOR
  CONGREGATION_ASSISTANT
}

/// Motivos fechados da recusa de um convite (os três do desenho da tela de aceite).
enum InvitationDeclineReason {
  NOT_THE_PERSON
  CANNOT_ASSUME_NOW
  RECEIVED_BY_MISTAKE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum EventType {
  ASSEMBLY
  REGIONAL_CONVENTION
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  FINISHED
  CANCELLED
}

enum EventDayStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  EXEMPT
}

enum CongregationListStatus {
  PENDING
  FINALIZED
}

enum ExpenseCategory {
  BUS_PAYMENT
  OTHER
}

// ============================================================
// MULTI-TENANCY ROOT
// ============================================================

model Circuit {
  id    String  @id @default(uuid()) @db.Uuid
  /// Coluna transitória de compatibilidade com o contrato anterior ao SUC-28.
  ///
  /// A API pública usa `name` como identificador do circuito. Durante o rollout,
  /// `code = name` preserva a unicidade entre versões; o SUC-60 remove a coluna
  /// em deploy posterior, conforme a regra de expand-and-contract.
  code  String? @unique @db.VarChar(20)
  name  String  @unique @db.VarChar(100)
  city  String  @db.VarChar(100)
  state String  @db.VarChar(2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  congregations Congregation[]
  users         User[]
  events        Event[]
  invitations   Invitation[]

  @@map("circuits")
}

// ============================================================
// CONGREGATIONS
// ============================================================

model Congregation {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(150)
  /// Opcional desde o autocadastro (SUC-37): a etapa de congregações coleta
  /// apenas nome e código, porque o coordenador do circuito não tem como saber o
  /// e-mail de cada congregação na hora do cadastro. Entra depois, na
  /// configuração da congregação ou no aceite do convite.
  email    String? @unique @db.VarChar(255)
  city     String? @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  circuitId String  @map("circuit_id") @db.Uuid
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                   User[]
  passengers              Passenger[]
  eventPassengers         EventPassenger[]
  congregationEventStatus CongregationEventStatus[]
  invitations             Invitation[]

  @@index([circuitId])
  @@map("congregations")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(150)
  email              String   @unique @db.VarChar(255)
  /// Celular de contato, apenas dígitos com DDD. A máscara do desenho é
  /// apresentação: guardar `(11) 98765-4321` tornaria qualquer comparação futura
  /// dependente de formatação.
  phone              String?  @db.VarChar(20)
  passwordHash       String?  @map("password_hash") @db.VarChar(255)
  /// Legado: a sessão passou para `Session` (SUC-77). Nada mais lê nem grava esta
  /// coluna; ela fica até o deploy seguinte à migration, que a remove (contract).
  refreshTokenHash   String?  @map("refresh_token_hash") @db.VarChar(255)
  /// Versao da sessao. Toda redefinicao ou troca de senha incrementa, e o
  /// JwtAuthGuard recusa access tokens emitidos com versao anterior — e o que
  /// mata o token roubado no instante da redefinicao, sem esperar os 15 minutos
  /// de expiracao natural.
  sessionVersion     Int      @default(0) @map("session_version")
  role               UserRole
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")

  circuitId String  @map("circuit_id") @db.Uuid
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  congregationId String?       @map("congregation_id") @db.Uuid
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts              Account[]
  createdEvents         Event[]                   @relation("EventCreatedBy")
  registeredPassengers  EventPassenger[]          @relation("RegisteredBy")
  registeredPayments    Payment[]                 @relation("PaymentRegisteredBy")
  registeredExpenses    Expense[]                 @relation("ExpenseRegisteredBy")
  finalizedLists        CongregationEventStatus[] @relation("FinalizedBy")
  createdInvitations    Invitation[]              @relation("InvitationCreatedBy")
  passwordResetRequests PasswordResetRequest[]
  auditLogs             AuditLog[]
  sessions              Session[]

  @@index([circuitId])
  @@index([congregationId])
  @@map("users")
}

/// Uma sessão por dispositivo (SUC-77). O refresh token carrega o `id` como `sid`,
/// então renovar ou sair atua só na sessão de quem pediu; entrar em outro aparelho
/// não derruba as demais. Redefinir ou trocar a senha apaga todas.
model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 do refresh token vigente. Rotaciona a cada renovação.
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(64)
  /// "Manter conectado" (SUC-39): define a duração do refresh token.
  extended         Boolean  @default(false)
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")

  @@index([userId, lastUsedAt])
  @@map("sessions")
}

model Account {
  id                String       @id @default(uuid()) @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(200)
  type        EventType
  ticketPrice Decimal     @map("ticket_price") @db.Decimal(10, 2)
  status      EventStatus @default(DRAFT)

  registrationDeadline DateTime @map("registration_deadline")
  paymentDeadline      DateTime @map("payment_deadline")

  venue        String  @db.VarChar(200)
  address      String  @db.VarChar(300)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(2)
  observations String? @db.Text

  circuitId String  @map("circuit_id") @db.Uuid
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eventDays               EventDay[]
  eventPassengers         EventPassenger[]
  congregationEventStatus CongregationEventStatus[]
  expenses                Expense[]

  @@index([circuitId])
  @@index([status])
  @@map("events")
}

model EventDay {
  id            String         @id @default(uuid()) @db.Uuid
  dayNumber     Int            @map("day_number")
  date          DateTime       @db.Date
  label         String         @db.VarChar(100)
  departureTime String         @map("departure_time") @db.VarChar(5)
  returnTime    String         @map("return_time") @db.VarChar(5)
  status        EventDayStatus @default(ACTIVE)

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventPassengerDays EventPassengerDay[]

  @@unique([eventId, date])
  @@unique([eventId, dayNumber])
  @@index([eventId])
  @@map("event_days")
}

// ============================================================
// PASSENGERS
// ============================================================

model Passenger {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(200)
  rgEncrypted  String  @map("rg_encrypted") @db.Text
  rgHash       String  @map("rg_hash") @db.VarChar(64)
  phone        String? @db.VarChar(20)
  observations String? @db.Text

  congregationId String       @map("congregation_id") @db.Uuid
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eventPassengers EventPassenger[]

  @@unique([congregationId, rgHash])
  @@index([congregationId])
  @@index([rgHash])
  @@map("passengers")
}

model EventPassenger {
  id              String        @id @default(uuid()) @db.Uuid
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  exemptionReason String?       @map("exemption_reason") @db.VarChar(300)
  observations    String?       @db.Text

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  passengerId String    @map("passenger_id") @db.Uuid
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  congregationId String       @map("congregation_id") @db.Uuid
  congregation   Congregation @relation(fields: [congregationId], references: [id])

  registeredById String @map("registered_by_id") @db.Uuid
  registeredBy   User   @relation("RegisteredBy", fields: [registeredById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eventPassengerDays EventPassengerDay[]
  payments           Payment[]

  @@unique([eventId, passengerId])
  @@index([eventId])
  @@index([passengerId])
  @@index([congregationId])
  @@index([paymentStatus])
  @@map("event_passengers")
}

model EventPassengerDay {
  id          String    @id @default(uuid()) @db.Uuid
  checkedIn   Boolean   @default(false) @map("checked_in")
  checkedInAt DateTime? @map("checked_in_at")

  eventPassengerId String         @map("event_passenger_id") @db.Uuid
  eventPassenger   EventPassenger @relation(fields: [eventPassengerId], references: [id], onDelete: Cascade)

  eventDayId String   @map("event_day_id") @db.Uuid
  eventDay   EventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)

  @@unique([eventPassengerId, eventDayId])
  @@index([eventPassengerId])
  @@index([eventDayId])
  @@map("event_passenger_days")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  paidAt       DateTime @map("paid_at")
  observations String?  @db.Text

  eventPassengerId String         @map("event_passenger_id") @db.Uuid
  eventPassenger   EventPassenger @relation(fields: [eventPassengerId], references: [id], onDelete: Cascade)

  registeredById String @map("registered_by_id") @db.Uuid
  registeredBy   User   @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventPassengerId])
  @@map("payments")
}

// ============================================================
// EXPENSES (event spending — circuit-level accounting)
// ============================================================

model Expense {
  id           String          @id @default(uuid()) @db.Uuid
  description  String          @db.VarChar(300)
  amount       Decimal         @db.Decimal(10, 2)
  category     ExpenseCategory
  incurredAt   DateTime        @map("incurred_at")
  observations String?         @db.Text

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  registeredById String @map("registered_by_id") @db.Uuid
  registeredBy   User   @relation("ExpenseRegisteredBy", fields: [registeredById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft-delete (auditoria financeira)

  @@index([eventId])
  @@index([category])
  @@map("expenses")
}

// ============================================================
// CONGREGATION EVENT STATUS (list finalization)
// ============================================================

model CongregationEventStatus {
  id     String                 @id @default(uuid()) @db.Uuid
  status CongregationListStatus @default(PENDING)

  congregationId String       @map("congregation_id") @db.Uuid
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  finalizedById String? @map("finalized_by_id") @db.Uuid
  finalizedBy   User?   @relation("FinalizedBy", fields: [finalizedById], references: [id])

  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([congregationId, eventId])
  @@index([eventId])
  @@map("congregation_event_status")
}

// ============================================================
// INVITATIONS
// ============================================================

/// Convite para um coordenador ou assistente de congregação entrar no sistema.
///
/// Apenas o SHA-256 do token é persistido; o valor em claro existe somente no
/// link enviado ao convidado. O estado não é uma coluna: deriva de `usedAt`,
/// `revokedAt` e `expiresAt`, para não haver como os dois divergirem.
model Invitation {
  id        String   @id @default(uuid()) @db.Uuid
  /// Dados do destinatário, como o coordenador do circuito os informou. Na tela
  /// de aceite são só pré-preenchimento: o convidado os confirma ou corrige, e o
  /// usuário nasce com o que ele enviou. `phone` guarda apenas dígitos.
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  role      UserRole
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)

  expiresAt          DateTime                 @map("expires_at")
  usedAt             DateTime?                @map("used_at")
  revokedAt          DateTime?                @map("revoked_at")
  /// Recusa feita pelo próprio convidado. O reenvio pelo circuito limpa os dois campos.
  declinedAt         DateTime?                @map("declined_at")
  declineReason      InvitationDeclineReason? @map("decline_reason")
  /// Último pedido de novo convite feito pelo convidado com o link expirado; limita o aviso ao circuito. O reenvio limpa.
  renewalRequestedAt DateTime?                @map("renewal_requested_at")

  circuitId String  @map("circuit_id") @db.Uuid
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  congregationId String       @map("congregation_id") @db.Uuid
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([circuitId])
  @@index([congregationId])
  @@map("invitations")
}

/// Solicitacoes de recuperacao de senha.
///
/// Toda solicitacao gera uma linha, inclusive quando o e-mail nao pertence a
/// conta alguma: e esse historico que alimenta o limite por e-mail, e contar
/// tambem os desconhecidos impede usar o 429 para descobrir quais e-mails
/// existem. Linha sem `userId` nunca tem token — nada foi enviado.
///
/// Apenas o SHA-256 do token e persistido. O valor em claro existe somente no
/// link enviado por e-mail.
///
/// `tokenHash` nulo em linha com `userId` significa pedido superado por outro
/// mais recente: o hash e limpo em vez de a linha ser apagada, porque a linha
/// ainda precisa ser contada pelo limite por e-mail.
model PasswordResetRequest {
  id String @id @default(uuid()) @db.Uuid

  /// Sempre normalizado em minusculas, para que variacoes de caixa caiam no
  /// mesmo balde do limite por e-mail.
  email String @db.VarChar(255)

  tokenHash String?   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([userId])
  /// O job de purga filtra só por `createdAt`, e o índice composto acima não
  /// serve: com `email` na frente, o Postgres não o usa para um range apenas de
  /// data. Mesmo motivo do `@@index([createdAt])` em `AuditLog`.
  @@index([createdAt])
  @@map("password_reset_requests")
}

/// Rascunhos de autocadastro de circuito (SUC-37).
///
/// Esta tabela é o fluxo inteiro antes da confirmação: enquanto o coordenador
/// não digita o código de 6 dígitos, não existe circuito, usuário nem
/// congregação — existe uma linha aqui. Na confirmação, tudo nasce numa
/// transação e a linha é marcada como usada.
///
/// O rascunho **não é um circuito incompleto**: nenhum identificador fica
/// reservado, e a unicidade de `Circuit.name` (também gravado na coluna
/// transitória `Circuit.code`) e `Congregation.code` só é imposta na
/// consolidação. Abandonar o fluxo deixa uma linha que expira e é purgada.
///
/// Toda tentativa gera uma linha, inclusive a recusada por e-mail ou código já
/// em uso — é esse histórico que alimenta o limite por e-mail. Linha sem
/// `codeHash` nunca teve e-mail enviado, e não guarda `payload`: dados de um
/// cadastro recusado não têm por que ficar armazenados.
///
/// Limitação conhecida: o limite é **por e-mail**, então ele protege o dono do
/// endereço de receber uma enxurrada de códigos, mas não impede sondar um
/// e-mail diferente a cada tentativa para descobrir quais já têm conta. O `409`
/// de e-mail duplicado é um oráculo de enumeração assumido — toda tela de
/// cadastro precisa dizer ao usuário que o e-mail já está em uso, e o card
/// SUC-37 pede o erro distinguível de propósito.
model CircuitSignupRequest {
  id String @id @default(uuid()) @db.Uuid

  /// Sempre normalizado em minúsculas, para que variações de caixa caiam no
  /// mesmo balde do limite por e-mail.
  email String @db.VarChar(255)

  /// SHA-256 do código de 6 dígitos. O valor em claro existe somente no e-mail.
  ///
  /// Deliberadamente **não** é único: com 6 dígitos, dois rascunhos vivos podem
  /// sortear o mesmo código, e uma constraint faria o segundo cadastro falhar
  /// por azar. A busca é sempre pelo rascunho pendente mais recente do e-mail, e
  /// o código é comparado depois.
  codeHash String? @map("code_hash") @db.VarChar(64)

  /// Cadastro já validado, com a senha em Argon2 — ela é hasheada aqui, no
  /// primeiro passo, e nunca mais trafega.
  ///
  /// Serializado porque nada aqui é consultável: ou o rascunho vira circuito, ou
  /// expira. Modelar coordenador, circuito e N congregações em colunas e tabelas
  /// filhas custaria um schema que só existe para ser lido uma vez.
  payload Json?

  /// Tentativas de código erradas. Seis dígitos são apenas 10^6 combinações, e
  /// sem teto de tentativas o código cai por força bruta — o limite por e-mail
  /// cobre o envio, não o chute.
  attempts Int @default(0)

  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  /// A purga filtra só por `createdAt`, e o índice composto acima não serve:
  /// com `email` na frente, o Postgres não o usa para um range apenas de data.
  /// Mesmo motivo do `@@index([createdAt])` em `PasswordResetRequest`.
  @@index([createdAt])
  @@map("circuit_signup_requests")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  action   String  @db.VarChar(50)
  entity   String  @db.VarChar(50)
  entityId String  @map("entity_id") @db.Uuid
  details  Json?
  ip       String? @db.VarChar(45)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
