# ============================================================
# SUOAC Backend - Variáveis de Ambiente (Template)
# ============================================================
# Este é o template de referência. Para configurar seu ambiente:
#
#   npm run setup:env
#
# O script gera .env automaticamente com secrets aleatórios.
# Nunca commite .env, .env.staging ou .env.production no Git.
# ============================================================

# ── Database ────────────────────────────────────────────────────
# Dev (Docker local, porta 5432):
DATABASE_URL=postgresql://suoac:suoac_dev@localhost:5432/suoac_dev

# Staging/Prod (Neon): Configurar nos respectivos .env.staging / .env.production
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/suoac?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/suoac?sslmode=require

# ── App ─────────────────────────────────────────────────────────
PORT=3000

# Valores válidos: development | test | staging | production
# - development: pino-pretty ativado, Swagger habilitado
# - test:        usado pelos testes E2E (banco isolado na porta 5433)
# - staging:     JSON logs, Swagger habilitado (homologação no Railway)
# - production:  JSON logs, Swagger desabilitado (produção no Railway)
NODE_ENV=development

# ── Logging ────────────────────────────────────────────────────
# Níveis: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# ── Security ──────────────────────────────────────────────────
# Pepper para hashing de senhas (Argon2). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=gerar-um-valor-aleatorio-de-64-caracteres-hex

# Chave de criptografia AES-256-GCM para dados sensíveis (RG). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=gerar-um-valor-aleatorio-para-encryption-key

# JWT para autenticacao
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gerar-um-valor-aleatorio-para-jwt-secret
JWT_REFRESH_SECRET=gerar-um-valor-aleatorio-para-jwt-refresh-secret
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
JWT_EXTENDED_REFRESH_EXPIRATION=2592000

# ── CORS ─────────────────────────────────────────────────────────
# Origens permitidas (comma-separated). Apenas staging/prod.
# Em dev, localhost com qualquer porta é permitido automaticamente.
ALLOWED_ORIGINS=https://suoac.example.com

# ── Rate Limiting ────────────────────────────────────────────────
# Requests por minuto por IP nas rotas em geral (default: 100)
RATE_LIMIT_MAX=100
# Requests por minuto por IP nas rotas de autenticação — /auth/login,
# /auth/refresh e /auth/change-password (default: 10). Valor baixo para
# mitigar brute-force / credential stuffing.
AUTH_RATE_LIMIT_MAX=10
# Solicitacoes de recuperacao de senha por hora, por e-mail (default: 3).
# Este e o limite que realmente protege o fluxo: as rotas de recuperacao NAO
# entram no AUTH_RATE_LIMIT_MAX, porque o frontend chama a API pelo servidor
# (BFF) e todas as solicitacoes chegariam pelo mesmo IP — o limite por IP
# bloquearia usuarios legitimos sem proteger ninguem. Ver card SUC-47.
PASSWORD_RESET_MAX_PER_HOUR=3
# Tentativas de autocadastro de circuito por hora, por e-mail (default: 5).
# Mesmo raciocinio do limite acima: as rotas de autocadastro ficam fora do
# AUTH_RATE_LIMIT_MAX porque chegam todas pelo IP do BFF. As tentativas
# recusadas por conflito (e-mail ou codigo em uso) contam no mesmo balde.
CIRCUIT_SIGNUP_MAX_PER_HOUR=5

# ── Frontend ─────────────────────────────────────────────────────
# Base usada para montar links enviados por e-mail. Obrigatoria em todos os
# ambientes: o link de recuperacao de senha e montado como
# ${FRONTEND_URL}/reset-password?token=...
# Producao: https://suoac.com | Staging: https://staging.suoac.com
FRONTEND_URL=http://localhost:3000

# ── E-mail (Resend) ──────────────────────────────────────────────
# Obrigatorias fora de development/test. Em desenvolvimento e teste nada e
# enviado: o adaptador de log registra a mensagem — e o link de recuperacao
# sai no log da aplicacao.
#
# Uma chave por ambiente, para poder revogar staging sem derrubar producao.
RESEND_API_KEY=re_sua_chave_do_resend
# O dominio precisa estar verificado no Resend, ou a entrega falha.
# Dominio de envio do projeto: mail.suoac.com (subdominio dedicado, para a
# reputacao do transacional nao se misturar com a do dominio principal).
EMAIL_FROM="SUOAC <nao-responda@mail.suoac.com>"

# ── Seed de produção ─────────────────────────────────────────────
# Usadas apenas por `prisma/seeds/prod.ts` (npm run db:seed:prod) para criar o
# primeiro coordenador. Sem elas o seed cai em valores de fallback e avisa no
# console — o que nao deve acontecer em producao.
ADMIN_EMAIL=coordenador@suoac.com
ADMIN_PASSWORD=definir-uma-senha-forte

# ============================================================
# AMBIENTES REMOTOS (Staging / Produção)
# ============================================================
# Para operar contra staging ou produção, crie os arquivos:
#
#   .env.staging     → NODE_ENV=staging   + DATABASE_URL/DIRECT_URL do Neon
#   .env.production  → NODE_ENV=production + DATABASE_URL/DIRECT_URL do Neon
#
# E use os scripts dedicados:
#
#   npm run db:migrate:staging   # aplica migrations em staging
#   npm run db:seed:staging      # roda seed em staging
#   npm run db:migrate:prod      # aplica migrations em produção
#   npm run db:seed:prod         # roda seed em produção
#
# ⚠️  Staging e produção pedem confirmação interativa antes de executar.
# ============================================================
