{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // TS 6: `@types/*` não são mais incluídos automaticamente — o build não precisa dos globais do Jest.
    "types": ["node"],
    // TS 6 (TS5011): exige `rootDir` explícito em vez de inferir o common source directory.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts", "prisma", "scripts"]
}
